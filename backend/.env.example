# ── Deployment ──
NODE_ENV=development
PORT=5001

# ── Database ──
MONGODB_URI=mongodb://localhost:27017/debateforge

# ── Cache (optional — app falls back to in-memory store if Redis is unavailable) ──
# For Upstash or any TLS-enabled Redis, use rediss:// (double-s)
REDIS_URL=redis://localhost:6379

# ── Auth ──
JWT_SECRET=your_super_secret_key_here      # generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_EXPIRY=7d                               # token lifetime — must match COOKIE_MAX_AGE in auth.controller.js
LOGIN_MAX_ATTEMPTS=5                        # failed logins before lockout
LOGIN_LOCKOUT_MINUTES=15                    # lockout duration

# ── Email (SMTP) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password                 # Gmail: use App Password, not account password
FROM_EMAIL=noreply@debateforge.com

# ── AI — use one of: Gemini (recommended free tier) or OpenAI ──
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here   # optional, fallback

# ── ElevenLabs TTS (optional — app uses browser Web Speech API if omitted) ──
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_voice_id_here

# ── ML microservice ──
ML_SERVICE_URL=http://localhost:8001
ML_API_KEY=your_ml_api_key_here

# ── CORS — comma-separated list of allowed frontend origins ──
# ⚠️  REQUIRED in production for both HTTP CORS and WebSocket CORS!
# Example for Render: FRONTEND_URL=https://debateforge.onrender.com
FRONTEND_URL=http://localhost:3000

# ── Local Model Toggles ──
USE_LOCAL_LLM=false
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── Push Notifications (VAPID) ──
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_EMAIL=mailto:admin@debateforge.com
