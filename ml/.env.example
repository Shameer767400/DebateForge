# ── ML Service Environment ──
# Only include variables that the ML microservice actually needs.

# Gemini API key — used by Whisper transcription fallback
GEMINI_API_KEY=your_gemini_api_key_here

# CORS — frontend origin
FRONTEND_URL=http://localhost:3000

# Local Model Toggles
USE_LOCAL_STT=true
USE_LOCAL_TTS=false
USE_LOCAL_MEMORY=true
